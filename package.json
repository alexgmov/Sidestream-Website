{
  "name": "sidestream-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "analytics:installer": "node scripts/report-installer-referrals.mjs",
    "analytics:referrals": "node scripts/report-referral-visits.mjs",
    "dev": "vite",
    "build": "npm run pricing:check && tsc -b && vite build && node scripts/stage-paid-landing-runtime.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-production-version.mjs",
    "build:hetzner-api": "rm -rf .server-dist && tsc -p tsconfig.server.json && mkdir -p .server-dist/config && cp config/pricing-contract.mjs config/upgrade-pricing-experiment.mjs .server-dist/config/",
    "billing:ensure-freedev": "node scripts/ensure-freedev-promo.mjs",
    "account:reset:alex": "node scripts/reset-alex-upgrade-state.mjs",
    "fresh-paid:reset": "node scripts/reset-alex-upgrade-state.mjs",
    "fresh-paid:reset-local": "node scripts/reset-local-production-for-paid-test.mjs",
    "fresh-paid:preflight": "node scripts/check-fresh-paid-test-handoff.mjs",
    "customer-360:readiness": "node scripts/check-customer-360-readiness.mjs",
    "db:migrate": "node scripts/apply-postgres-migrations.mjs",
    "devices:audit": "node scripts/audit-license-devices.mjs",
    "devices:manage": "node scripts/manage-license-device.mjs",
    "leads:dump": "node scripts/dump-download-leads.mjs",
    "leads:migrate": "node scripts/migrate-download-leads-to-postgres.mjs",
    "release:publish-manifest": "node scripts/publish-release-manifest.mjs",
    "release:rollout": "node scripts/advance-release-rollout.mjs",
    "release:upload-hetzner": "node scripts/upload-hetzner-artifact.mjs",
    "report:upgrade-pricing": "node scripts/report-upgrade-pricing-experiment.mjs",
    "meta-spend:import": "node scripts/import-meta-ad-spend.mjs",
    "test:api": "node scripts/run-api-tests.mjs",
    "test:acquisition-journey-matrix": "node scripts/test-acquisition-journey-matrix.mjs",
    "test:acquisition-journey-matrix-postgres": "node scripts/test-acquisition-journey-matrix.mjs --postgres",
    "test:customer-360": "node scripts/run-customer-360-tests.mjs",
    "test:customer-360-postgres": "node scripts/run-customer-360-tests.mjs --postgres",
    "test:credits": "node --experimental-strip-types --test tests/download-credits.test.mjs && npm run test:migrations",
    "test:download-referral": "node --test tests/download-referral.test.mjs",
    "test:installer-delivery": "node --experimental-strip-types --test tests/installer-delivery.test.mjs",
    "test:paid-acquisition-e2e": "node --experimental-strip-types --test tests/paid-acquisition-e2e-fixtures.test.mjs",
    "test:referral-visits": "node --test tests/referral-visits.test.mjs",
    "test:release-rollout": "node --test tests/release-rollout-policy.test.mjs",
    "test:renamed-launcher-attribution": "node --test tests/renamed-launcher-attribution.test.mjs",
    "test:entitlement": "node --experimental-strip-types --test tests/entitlement.test.mjs",
    "test:migrations": "node --experimental-strip-types --test tests/migrations.test.mjs",
    "test:meta-roas-postgres": "node --experimental-strip-types --test --test-concurrency=1 tests/meta-roas-report-postgres.test.mjs",
    "test:postgres-config": "node --experimental-strip-types --test tests/postgres-config.test.mjs",
    "test:postgres-transfer": "node --test tests/postgres-transfer.test.mjs",
    "test:postgres-integration": "node scripts/run-postgres-integration.mjs",
    "test:single-device": "node --experimental-strip-types --test tests/entitlement.test.mjs tests/license-environment.test.mjs tests/single-device-policy.test.mjs tests/single-device-core.test.mjs tests/single-device-ops.test.mjs tests/single-device-transfer-flow.test.mjs tests/single-device-download-auth.test.mjs && npm run test:single-device-postgres",
    "test:single-device-ops": "node --experimental-strip-types --test tests/single-device-ops.test.mjs",
    "test:single-device-postgres": "node --experimental-strip-types --test --test-concurrency=1 tests/single-device-postgres.test.mjs",
    "test:support": "npm run build:hetzner-api && node --test tests/support-automation.test.mjs && npm run test:migrations",
    "typecheck": "tsc --noEmit",
    "verify:checkout-contract": "node scripts/verify-production-source.mjs --checkout-only && node --experimental-strip-types --test tests/checkout-contract.test.mjs",
    "promote:production-canonical": "node scripts/promote-canonical-production.mjs",
    "verify:production-source": "node scripts/verify-production-source.mjs",
    "verify:production-live": "node scripts/verify-production-live.mjs",
    "verify:database-transfer": "node scripts/verify-postgres-transfer.mjs",
    "verify:database-port-closed": "node scripts/verify-postgres-port-closed.mjs",
    "verify:vercel-build": "node scripts/verify-vercel-build.mjs",
    "verify:vercel-contract": "node scripts/validate-vercel-contract.mjs",
    "installer-provider:set": "node scripts/set-installer-provider.mjs",
    "deploy:production": "npm run verify:production-source && npm run test:entitlement && npx vercel@latest build --prod --yes --scope alex-3685s-projects && npm run verify:vercel-build && npx vercel@latest deploy --prebuilt --prod --yes --scope alex-3685s-projects && npm run promote:production-canonical && npm run verify:production-live",
    "preview": "vite preview",
    "start:hetzner-api": "node .server-dist/server/hetzner-api.js",
    "pricing:sync": "node scripts/sync-pricing-contract.mjs && node scripts/build-paid-landing.mjs",
    "pricing:check": "node scripts/sync-pricing-contract.mjs --check && node scripts/build-paid-landing.mjs --check && node --test tests/pricing-contract.test.mjs",
    "reconcile:paid-telemetry-handoff": "node --experimental-strip-types scripts/reconcile-paid-telemetry-handoff.mjs",
    "replay:paid-telemetry-handoff": "node --experimental-strip-types scripts/replay-paid-telemetry-handoff.mjs",
    "launcher-attribution:server": "node scripts/run-renamed-launcher-proof-server.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.76",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.1.17",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.1",
    "@vercel/functions": "^3.7.5",
    "pg": "^8.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stripe": "^22.3.0",
    "svix": "^1.99.1",
    "tailwindcss": "^4.1.17",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
