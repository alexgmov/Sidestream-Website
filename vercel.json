{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev -- --host 127.0.0.1 --port $PORT",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/internal/stripe-events/process",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/download-leads/replay",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/internal/maintenance",
      "schedule": "13 4 * * *"
    },
    {
      "path": "/api/internal/customer-usage/sync",
      "schedule": "27 5 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/alex",
      "destination": "https://sidestream.tv/?utm_source=instagram&utm_medium=social&utm_campaign=alex-bio",
      "permanent": false
    },
    {
      "source": "/alex/",
      "destination": "https://sidestream.tv/?utm_source=instagram&utm_medium=social&utm_campaign=alex-bio",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "https://sidestream.tv/?utm_source=instagram&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/ig/",
      "destination": "https://sidestream.tv/?utm_source=instagram&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/m",
      "destination": "https://sidestream.tv/?utm_source=manychat",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "https://sidestream.tv/",
      "permanent": true
    },
    {
      "source": "/:legacy/Sidestream.html",
      "destination": "https://sidestream.tv/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.sidestream.tv" }],
      "destination": "https://sidestream.tv/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sidestream-xi.vercel.app" }],
      "destination": "https://sidestream.tv/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sidestream.tv" }],
      "destination": "https://sidestream.tv/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "sidestream-xi.vercel.app" }],
      "destination": "https://sidestream.tv/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/account.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/thank-you.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/upgrade.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
